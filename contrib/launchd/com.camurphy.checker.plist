<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.camurphy.checker</string>
    <!--
      Replace __HOME__ with your home directory; launchd does not expand it.

      The binary carries its own runtime and its permissions are baked in, so this needs nothing on
      PATH and no toolchain installed. Config and plugins are read from ~/.config/checker.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/checker</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Prevent hammering various endpoints if the process is crash-looping. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/checker.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/checker.log</string>
</dict>
</plist>
